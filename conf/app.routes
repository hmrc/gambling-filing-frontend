# microservice specific routes

->          /hmrc-frontend                               hmrcfrontend.Routes

GET         /                                            controllers.IndexController.onPageLoad()

GET         /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET         /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET         /refresh-session                             controllers.KeepAliveController.keepAlive()

GET         /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET         /check-your-answers                          controllers.CheckYourAnswersController.onPageLoad()

GET         /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET         /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET         /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET        /there-is-a-problem-with-the-service          controllers.SystemErrorController.onPageLoad()

GET        /there-is-a-problem-access-denied             controllers.AccessDeniedController.onPageLoad()
GET        /page-not-found                               controllers.PageNotFoundController.onPageLoad()

GET        /registration-certificate                     controllers.ViewRegistrationCertificateController.onPageLoad()

GET        /machines-available                          controllers.MachinesAvailableController.onPageLoad(mode: Mode = NormalMode)
POST       /machines-available                          controllers.MachinesAvailableController.onSubmit(mode: Mode = NormalMode)
GET        /change-machines-available                   controllers.MachinesAvailableController.onPageLoad(mode: Mode = CheckMode)
POST       /change-machines-available                   controllers.MachinesAvailableController.onSubmit(mode: Mode = CheckMode)

GET        /mgd-lower-rate                              controllers.MgdLowerRateController.onPageLoad(mode: Mode = NormalMode)
POST       /mgd-lower-rate                              controllers.MgdLowerRateController.onSubmit(mode: Mode = NormalMode)
GET        /change-mgd-lower-rate                       controllers.MgdLowerRateController.onPageLoad(mode: Mode = CheckMode)
POST       /change-mgd-lower-rate                       controllers.MgdLowerRateController.onSubmit(mode: Mode = CheckMode)

GET        /mgd-standard-rate                           controllers.MgdStandardRateController.onPageLoad(mode: Mode = NormalMode)
POST       /mgd-standard-rate                           controllers.MgdStandardRateController.onSubmit(mode: Mode = NormalMode)
GET        /change-mgd-standard-rate                    controllers.MgdStandardRateController.onPageLoad(mode: Mode = CheckMode)
POST       /change-mgd-standard-rate                    controllers.MgdStandardRateController.onSubmit(mode: Mode = CheckMode)

GET        /total-net-takings-lower-rate                 controllers.NetTakingsLowerController.onPageLoad(mode: Mode = NormalMode)
POST       /total-net-takings-lower-rate                 controllers.NetTakingsLowerController.onSubmit(mode: Mode = NormalMode)
GET        /change-total-net-takings-lower-rate          controllers.NetTakingsLowerController.onPageLoad(mode: Mode = CheckMode)
POST       /change-total-net-takings-lower-rate          controllers.NetTakingsLowerController.onSubmit(mode: Mode = CheckMode)

GET         /calculated-mgd-lower-rate                   controllers.CalculationLowerCheckController.onPageLoad(mode: Mode = NormalMode)
POST        /calculated-mgd-lower-rate                   controllers.CalculationLowerCheckController.onSubmit(mode: Mode = NormalMode)
GET         /change-calculated-mgd-lower-rate            controllers.CalculationLowerCheckController.onPageLoad(mode: Mode = CheckMode)
POST        /change-calculated-mgd-lower-rate            controllers.CalculationLowerCheckController.onSubmit(mode: Mode = CheckMode)

GET        /total-net-takings-standard-rate              controllers.NetTakingsStandardController.onPageLoad(mode: Mode = NormalMode)
POST       /total-net-takings-standard-rate              controllers.NetTakingsStandardController.onSubmit(mode: Mode = NormalMode)
GET        /change-total-net-takings-standard-rate       controllers.NetTakingsStandardController.onPageLoad(mode: Mode = CheckMode)
POST       /change-total-net-takings-standard-rate       controllers.NetTakingsStandardController.onSubmit(mode: Mode = CheckMode)

GET        /total-net-takings-higher-rate                controllers.NetTakingsHigherController.onPageLoad(mode: Mode = NormalMode)
POST       /total-net-takings-higher-rate                controllers.NetTakingsHigherController.onSubmit(mode: Mode = NormalMode)
GET        /change-total-net-takings-higher-rate         controllers.NetTakingsHigherController.onPageLoad(mode: Mode = CheckMode)
POST       /change-total-net-takings-higher-rate         controllers.NetTakingsHigherController.onSubmit(mode: Mode = CheckMode)

GET        /select-filed-return               controllers.SubmittedReturnsController.onPageLoad()
GET        /view-filed-return/:consecNo       controllers.SubmittedReturnsController.viewFiledReturn(consecNo: Int)

GET        /select-return                      controllers.SelectReturnController.onPageLoad()
POST       /select-return                      controllers.SelectReturnController.onSubmit()

GET        /net-takings-lower-rate                 controllers.NetTakingsLowerRateController.onPageLoad(mode: Mode = NormalMode)
POST       /net-takings-lower-rate                 controllers.NetTakingsLowerRateController.onSubmit(mode: Mode = NormalMode)
GET        /change-net-takings-lower-rate          controllers.NetTakingsLowerRateController.onPageLoad(mode: Mode = CheckMode)
POST       /change-net-takings-lower-rate          controllers.NetTakingsLowerRateController.onSubmit(mode: Mode = CheckMode)

GET        /net-takings-standard-rate                 controllers.NetTakingsStandardRateController.onPageLoad(mode: Mode = NormalMode)
POST       /net-takings-standard-rate                 controllers.NetTakingsStandardRateController.onSubmit(mode: Mode = NormalMode)
GET        /change-net-takings-standard-rate          controllers.NetTakingsStandardRateController.onPageLoad(mode: Mode = CheckMode)
POST       /change-net-takings-standard-rate          controllers.NetTakingsStandardRateController.onSubmit(mode: Mode = CheckMode)

GET        /net-takings-higher-rate                 controllers.NetTakingsHigherRateController.onPageLoad(mode: Mode = NormalMode)
POST       /net-takings-higher-rate                 controllers.NetTakingsHigherRateController.onSubmit(mode: Mode = NormalMode)
GET        /change-net-takings-higher-rate          controllers.NetTakingsHigherRateController.onPageLoad(mode: Mode = CheckMode)
POST       /change-net-takings-higher-rate          controllers.NetTakingsHigherRateController.onSubmit(mode: Mode = CheckMode)